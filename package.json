{
  "name": "@davidsneighbour/nanny",
  "description": "Repo management and maintenance CLI for davidsneighbour projects.",
  "version": "0.5.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidsneighbour/nanny.git"
  },
  "dependencies": {
    "c12": "3.3.4",
    "confbox": "0.3.1",
    "fast-glob": "3.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@dnbhq/biome-config": "0.3.1",
    "@dnbhq/lintstaged-config": "0.2.1",
    "@dnbhq/markdownlint-config": "0.2.11",
    "@dnbhq/release-config": "1.1.3",
    "@dnbhq/secretlint-config": "0.1.1",
    "@dnbhq/tsconfig": "0.1.6",
    "@release-it/conventional-changelog": "12.0.0",
    "@types/node": "26.1.2",
    "cspell": "10.3.0",
    "lint-staged": "17.5.1",
    "release-it": "21.0.2",
    "simple-git-hooks": "2.14.0",
    "typescript": "7.0.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run check:biome && npm run lint && npm run validate && npm run test:package-init",
    "check:biome": "biome check",
    "ci": "npm run typecheck && npm run build",
    "lint": "npm run lint:markdown && npm run lint:secrets && npm run lint:spelling",
    "lint:markdown": "markdownlint-cli2 \"**/*.{md,mdx}\"",
    "lint:secrets": "dnb-secretlint \"**/*\"",
    "lint:spelling": "cspell --no-progress .",
    "lint:staged": "lint-staged",
    "prepare": "simple-git-hooks",
    "prepublishOnly": "npm run build",
    "release": "npm run ci && release-it",
    "release:dry": "npm run ci && release-it --dry-run",
    "test:package-init": "npm run build && node dist/tests/package-init.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "npm run validate:types",
    "validate:types": "npm run typecheck"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "nanny": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "smol-toml": "1.8.0",
    "js-yaml": "5.2.2",
    "linkify-it": "5.0.2",
    "markdown-it": "14.3.0",
    "markdownlint-rule-title-case-style": {
      "markdownlint": "0.41.1"
    }
  },
  "cspell": {
    "version": "0.2",
    "language": "en-GB",
    "dictionaryDefinitions": [
      {
        "name": "nanny-project-words",
        "path": "./.vscode/dictionary.txt",
        "addWords": true
      }
    ],
    "dictionaries": [
      "nanny-project-words"
    ],
    "ignorePaths": [
      "node_modules",
      "dist",
      ".wireit",
      "package-lock.json",
      "CHANGELOG.md"
    ]
  },
  "simple-git-hooks": {
    "commit-msg": "npx --no -- commitlint --edit $1",
    "pre-commit": "npx --no -- lint-staged"
  },
  "type": "module"
}
