{
  "name": "@davidsneighbour/nanny",
  "description": "Repo management and maintenance CLI for davidsneighbour projects.",
  "version": "0.4.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidsneighbour/nanny.git"
  },
  "dependencies": {
    "c12": "3.3.4",
    "confbox": "0.2.4",
    "fast-glob": "3.3.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@dnbhq/tsconfig": "0.1.6",
    "@release-it/conventional-changelog": "11.0.1",
    "@types/node": "26.1.1",
    "husky": "9.1.7",
    "release-it": "20.2.1",
    "typescript": "7.0.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "ci": "npm run typecheck && npm run build",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "release": "npm run ci && release-it",
    "test:package-init": "npm run build && node dist/tests/package-init.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "nanny": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module"
}
