{
  "name": "@davidsneighbour/nanny",
  "description": "Repo management and maintenance CLI for davidsneighbour projects.",
  "version": "0.5.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidsneighbour/nanny.git"
  },
  "dependencies": {
    "c12": "3.3.4",
    "confbox": "0.2.4",
    "fast-glob": "3.3.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@dnbhq/tsconfig": "0.1.6",
    "@release-it/conventional-changelog": "11.0.1",
    "@types/node": "26.1.1",
    "cspell": "10.0.1",
    "release-it": "20.2.1",
    "simple-git-hooks": "2.13.1",
    "typescript": "7.0.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "ci": "npm run typecheck && npm run build",
    "prepare": "simple-git-hooks",
    "prepublishOnly": "npm run build",
    "release": "npm run ci && release-it",
    "spellcheck": "cspell --no-progress .",
    "test:package-init": "npm run build && node dist/tests/package-init.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "nanny": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "simple-git-hooks": {
    "commit-msg": "npx --no -- commitlint --edit $1"
  },
  "cspell": {
    "version": "0.2",
    "language": "en-GB",
    "dictionaryDefinitions": [
      {
        "name": "nanny-project-words",
        "path": "./.vscode/dictionary.txt",
        "addWords": true
      }
    ],
    "dictionaries": [
      "nanny-project-words"
    ],
    "ignorePaths": [
      "node_modules",
      "dist",
      ".wireit",
      "package-lock.json",
      "CHANGELOG.md"
    ]
  }
}
